{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@stacklogs/vue-draggable": ["../../packages/vue-draggable/types/index.d.mts"],
      "@stacklogs/vue-draggable/plugins": ["../../packages/vue-draggable/types/plugins.d.mts"],
      "@stacklogs/vue-draggable/history": ["../../packages/vue-draggable/types/history.d.mts"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../shared/**/*.ts", "../shared/**/*.vue"]
}
