{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "vuedraggable": ["../packages/vue-draggable/types/index.d.mts"],
      "@stacklogs/vue-draggable/plugins": ["../packages/vue-draggable/types/plugins.d.mts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
