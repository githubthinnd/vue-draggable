{
  "name": "@stacklogs/vue-draggable",
  "version": "1.0.0",
  "description": "Vue 3 drag and drop component for sortable lists: reorder, drag between lists, nested trees, kanban boards, transition-group animations, multi-select drag and swap. TypeScript and SSR ready.",
  "keywords": [
    "vue",
    "vue3",
    "vue-3",
    "draggable",
    "drag-and-drop",
    "drag",
    "drop",
    "dnd",
    "sortable",
    "sortable-list",
    "reorder",
    "list",
    "kanban",
    "nested",
    "tree",
    "transition-group",
    "multi-drag",
    "swap",
    "typescript",
    "ssr",
    "nuxt",
    "component"
  ],
  "homepage": "https://github.com/githubthinnd/vue-draggable/tree/master/packages/vue-draggable#readme",
  "bugs": {
    "url": "https://github.com/githubthinnd/vue-draggable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubthinnd/vue-draggable.git",
    "directory": "packages/vue-draggable"
  },
  "license": "MIT",
  "author": "Nhữ Duy Thìn",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./types/plugins.d.mts",
        "default": "./dist/plugins.mjs"
      },
      "require": {
        "types": "./types/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./history": {
      "import": {
        "types": "./types/history.d.mts",
        "default": "./dist/history.mjs"
      },
      "require": {
        "types": "./types/history.d.cts",
        "default": "./dist/history.cjs"
      }
    },
    "./src/vuedraggable": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./src/vuedraggable.js": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/vuedraggable.umd.js": {
      "types": "./types/index.d.cts",
      "default": "./dist/vuedraggable.umd.js"
    },
    "./dist/vuedraggable.umd.min.js": {
      "types": "./types/index.d.cts",
      "default": "./dist/vuedraggable.umd.min.js"
    },
    "./dist/vuedraggable.common.js": {
      "types": "./types/index.d.cts",
      "default": "./dist/vuedraggable.common.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/vuedraggable.umd.min.js",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "plugins": [
        "./types/plugins.d.ts"
      ],
      "history": [
        "./types/history.d.ts"
      ],
      "src/vuedraggable": [
        "./types/index.d.ts"
      ],
      "src/vuedraggable.js": [
        "./types/index.d.ts"
      ],
      "dist/vuedraggable.umd.js": [
        "./types/index.d.cts"
      ],
      "dist/vuedraggable.umd.min.js": [
        "./types/index.d.cts"
      ],
      "dist/vuedraggable.common.js": [
        "./types/index.d.cts"
      ]
    }
  },
  "unpkg": "./dist/vuedraggable.umd.min.js",
  "jsdelivr": "./dist/vuedraggable.umd.min.js",
  "files": [
    "dist",
    "types",
    "src/vuedraggable.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.isolated.json",
    "test": "vitest run --passWithNoTests",
    "verify:package": "publint --strict && node scripts/attw.mjs",
    "verify:dist": "vitest run --config vitest.package.config.mts"
  },
  "dependencies": {
    "sortablejs": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "acorn": "^8.15.0",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "rollup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
